# Copy this file to calendars.env in this same folder.
# calendars.env is gitignored. Paste the secret iCal address there.
#
# Google Calendar: open the calendar settings, then Integrate calendar,
# then Secret address in iCal format.
# Apple Calendar: share the calendar and copy the webcal or https link.
# A webcal link is fetched as https by this computer. The frame never sees it.
#
# One feed per line. A label and a pipe are optional:
# Family|https://example.test/calendar.ics
#
# PORT=8787
# DAYS=7
# TZ=America/Los_Angeles
# CACHE_MINUTES=10
